<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MireaProject"
            android:textColor="@color/brand_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/student_full"
            android:textColor="@color/brand_muted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="В приложении собраны четыре части практической работы: обзор проекта, работа с датчиками, фотозаметка через системную камеру и диктофон на основе MediaRecorder."
            android:textColor="@color/brand_text"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Экран датчиков показывает список поддерживаемых сенсоров, текущие значения акселерометра и вычисляет направление на север по данным акселерометра и магнитометра."
            android:textColor="@color/brand_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Экран камеры решает творческую задачу фотозаметки: снимок сохраняется в папку приложения, а подпись к нему отображается рядом с фотографией."
            android:textColor="@color/brand_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Экран диктофона позволяет записывать и воспроизводить голосовые заметки. Разрешения на камеру и микрофон запрашиваются в момент использования."
            android:textColor="@color/brand_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@color/brand_surface"
            android:padding="16dp"
            android:textColor="@color/brand_text"
            android:textSize="16sp" />
    </LinearLayout>

</ScrollView>
